(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "governance") 8
      (string=? candidate "statute") 4
      (string=? candidate "certification") 4
      (string=? candidate "membership") 3
      (string=? candidate "structure") 4
      (string=? candidate "trade") 5
      (string=? candidate "transparency") 1
      (string=? candidate "contact") 1
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "governance")
      (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 3 "id")
        (= i 4) (entry-field a 4 "id")
        (= i 5) (entry-field a 9 "id")
        (= i 6) (entry-field a 15 "id")
        (= i 7) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "statute")
      (cond
        (= i 0) (entry-field a 1 "id")
        (= i 1) (entry-field a 3 "id")
        (= i 2) (entry-field a 4 "id")
        (= i 3) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "certification")
      (cond
        (= i 0) (entry-field a 5 "id")
        (= i 1) (entry-field a 11 "id")
        (= i 2) (entry-field a 12 "id")
        (= i 3) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "membership")
      (cond
        (= i 0) (entry-field a 6 "id")
        (= i 1) (entry-field a 7 "id")
        (= i 2) (entry-field a 8 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "structure")
      (cond
        (= i 0) (entry-field a 7 "id")
        (= i 1) (entry-field a 8 "id")
        (= i 2) (entry-field a 17 "id")
        (= i 3) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "trade")
      (cond
        (= i 0) (entry-field a 9 "id")
        (= i 1) (entry-field a 10 "id")
        (= i 2) (entry-field a 11 "id")
        (= i 3) (entry-field a 13 "id")
        (= i 4) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "transparency")
      (cond
        (= i 0) (entry-field a 16 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "contact")
      (cond
        (= i 0) (entry-field a 19 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-9411-tha-fti (ADR-2607141700): 20 fti entries, 19 of them cited to the federation's own domain. Extend the catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0) 1
      (= i 1) 2
      (= i 2) 1
      (= i 3) 2
      (= i 4) 2
      (= i 5) 2
      (= i 6) 1
      (= i 7) 2
      (= i 8) 2
      (= i 9) 2
      (= i 10) 1
      (= i 11) 2
      (= i 12) 1
      (= i 13) 1
      (= i 14) 2
      (= i 15) 1
      (= i 16) 1
      (= i 17) 1
      (= i 18) 2
      (= i 19) 1
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 1)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 2)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 3)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 4)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))

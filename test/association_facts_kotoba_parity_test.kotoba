(ns association-facts-kotoba-parity-test
  "The FTI catalog in Clojure and in Kotoba, field by field.

  Both are readings of `data/datascript-tx.edn`, so this is not two
  implementations of a rule; it is one body of facts written three times, and
  the risk is transcription -- a wrong URL, a dropped field, a topic that lost
  its entry. Every field of every entry is compared, plus the counts and topic
  membership, because a catalog is exactly the shape where checking a sample
  checks the entries someone already looked at.

  Since 2026-09-11 both readings are GENERATED by scripts/gen_sources.cljs.
  That does not retire this test, it changes what it catches: a generator can
  emit two files that agree with each other and with neither the data nor the
  language. This test executes the Kotoba module through the compiler, so it
  answers a question the generator cannot -- what the module DOES when run,
  on every backend it claims.

  `:association-rule/topic` is a SET in the map and a VECTOR in the data file,
  and `topic` is indexed by position. A set has no order, so the expected
  order is read from the data file rather than kept in a list here: a
  hand-kept list is a fourth copy of the catalog, and it was the copy most
  likely to be forgotten when an entry was added."
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.edn :as edn]
            [association.facts :as facts]
            [kotoba.compiler.core :as compiler]
            [kotoba.kir :as ir]))

(def ^:private source (slurp "src/association_facts.kotoba"))
(def ^:private kir (:kir (compiler/compile-source source :js-kotoba-v1)))
(defn- call [f & args] (ir/execute kir f (vec args)))
(defn- present [option] (when (second option) (nth option 2)))

(def ^:private slug "fti")
(def ^:private fields
  ["id" "title" "association" "isic" "country" "kind" "url" "url-provenance"
   "established-date" "last-revised-date" "retrieved-at"])
(def ^:private kw->field
  (into {} (map (fn [f] [f (keyword "association-rule" f)]) fields)))
(def ^:private entries (vec (facts/spec-basis slug)))
(def ^:private tx (edn/read-string (slurp "data/datascript-tx.edn")))
(def ^:private topic-order
  "Written order, from the data file -- the only place the order exists."
  (mapv #(mapv name (:association-rule/topic %)) tx))

(deftest the-fixture-reads-a-real-catalog
  ;; An empty catalog compares equal to an empty port, and a fixture that
  ;; failed to load is indistinguishable from one that loaded nothing.
  (is (pos? (count entries)))
  (is (= (count entries) (count topic-order)))
  (is (= (count entries) (count tx))))

(deftest the-map-says-what-the-data-file-says
  ;; The generator writes the map from the data file. Nothing else checks that
  ;; it was re-run: an edit to the data file alone leaves a map that is stale
  ;; and still parses, still passes every other test here, and still serves
  ;; the old answer.
  (is (= (count tx) (count entries)))
  (doseq [[i [from-data from-map]] (map-indexed vector (map vector tx entries))]
    (testing (str "entry " i " " (:association-rule/id from-data))
      (doseq [f fields]
        (is (= (get from-data (kw->field f)) (get from-map (kw->field f)))
            (str "field " f)))
      (is (= (set (:association-rule/topic from-data))
             (set (:association-rule/topic from-map)))))))

(deftest every-entry-carries-a-checkable-citation
  ;; A URL with no recorded marker cannot be re-verified: scripts/
  ;; verify_citations.cljs would fetch it, find 200, and have nothing to ask
  ;; for. That entry would then be permanently green regardless of what the
  ;; page said. Checked offline here; the fetch itself is the script's job.
  (let [evidence (edn/read-string (slurp "data/citation-evidence.edn"))]
    (is (= (set (map :association-rule/id tx)) (set (keys evidence)))
        "every entry has an evidence record and every record has an entry")
    (doseq [e tx]
      (let [id (:association-rule/id e)
            rec (get evidence id)]
        (testing id
          (is (= (:association-rule/url e) (:url rec)))
          (is (seq (:markers rec)) "a record with no marker checks nothing")
          (is (every? string? (:markers rec))))))))

(deftest every-field-of-every-entry-is-transcribed
  (is (= (count entries) (call 'entry-count slug)))
  (doseq [[i entry] (map-indexed vector entries)]
    (doseq [f fields]
      (testing (str "entry " i " / " f)
        (let [expected (get entry (kw->field f))
              expected (cond (keyword? expected) (name expected)
                             (nil? expected) nil
                             :else expected)]
          (is (= expected (present (call 'entry-field slug i f)))))))))

(deftest topics-are-complete-and-in-the-order-the-data-file-wrote
  (doseq [[i names] (map-indexed vector topic-order)]
    (testing (str "entry " i)
      (is (= (count names) (call 'topic-count slug i))
          "one number for every entry is the mistake this invites")
      (is (= (set names)
             (set (map name (:association-rule/topic (nth entries i)))))
          "the written order must name exactly the set the map holds")
      (doseq [[t nm] (map-indexed vector names)]
        (is (= nm (present (call 'topic slug i t))))))))

(deftest by-topic-answers-the-same-entries
  (doseq [t (distinct (apply concat topic-order))]
    (testing t
      (let [cljc (mapv :association-rule/id (facts/by-topic slug (keyword t)))]
        (is (pos? (count cljc)) "a topic nothing carries proves nothing")
        (is (= (count cljc) (call 'by-topic-count slug t)))
        ;; Every position, not just the first: a port that answered entry 0 for
        ;; every index passed the earlier version of this test.
        (doseq [[i id] (map-indexed vector cljc)]
          (is (= id (present (call 'by-topic-id slug t i)))))
        (is (nil? (present (call 'by-topic-id slug t (count cljc))))
            "one past the end is not an entry"))))
  (is (zero? (call 'by-topic-count slug "no-such-topic")))
  (is (nil? (present (call 'by-topic-id slug "no-such-topic" 0)))))

(deftest an-unknown-association-is-covered-by-nothing
  (doseq [other ["zzz" ""]]
    (is (false? (call 'association-covered? other)))
    (is (zero? (call 'entry-count other)))
    (is (nil? (present (call 'entry-field other 0 "id"))))
    (is (nil? (present (call 'coverage-note other))))
    (is (nil? (facts/spec-basis other)) "and the map agrees")))

(deftest an-index-outside-the-catalog-is-not-an-entry
  (doseq [i [-1 (count entries) (+ 1000 (count entries))]]
    (is (nil? (present (call 'entry-field slug i "id"))) (str "index " i))
    (is (zero? (call 'topic-count slug i)) (str "index " i))))

(deftest the-runner-and-deps-edn-agree
  ;; test/run_suite.cljs carries its own copy of the test pins, because it
  ;; builds a -Sdeps map for a scratch classpath and cannot read the :test
  ;; alias for paths it must replace. A second copy of a pin is a second pin
  ;; unless something compares them; this is that something.
  (let [deps (slurp "deps.edn")
        runner (slurp "test/run_suite.cljs")
        ;; The runner writes its pins inside a string literal, so the
        ;; quotes around them are escaped on disk. Matching on the sha itself
        ;; rather than on the quoting keeps this from failing over a backslash.
        shas (fn [t] (set (map second (re-seq #":git/sha[^0-9a-f]{1,3}([0-9a-f]{40})" t))))]
    (is (seq (shas deps)) "deps.edn pins nothing by sha, so there is nothing to agree about")
    (is (= (shas deps) (shas runner))
        "the runner's pins and deps.edn's pins have diverged")))

(deftest the-module-compiles-for-every-target-it-claims
  (doseq [target [:js-kotoba-v1 :wasm32-kotoba-v1 :x86_64-kotoba-v1 :aarch64-kotoba-v1]]
    (testing (name target)
      (is (some? (compiler/compile-source source target {}))))))
